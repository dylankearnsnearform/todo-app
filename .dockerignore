# Keep the build context small and the image clean.
venv/
.venv/
_bmad/
_bmad-output/
.claude/
.git/
.github/
docs/
node_modules/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test / coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/
test-results/
playwright-report/

# Local databases (never bake data into the image)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Env
.env
