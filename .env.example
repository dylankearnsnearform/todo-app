# Copy to .env and adjust. Tests read these via os.environ (see tests/conftest.py).

# Which environment the tests target: "local" runs an in-process/live server the
# suite manages itself; "remote" points E2E at an already-running deployment.
TEST_ENV=local

# Base URL for browser (E2E) tests. Leave unset for TEST_ENV=local and the suite
# will boot a live uvicorn server on a random port automatically.
# Set this to hit an already-running server instead:
# BASE_URL=http://127.0.0.1:8000

# Base URL the API/integration client targets. For in-process TestClient tests
# this is ignored (the app is mounted directly). Used only if you point the
# integration client at a remote API.
# API_URL=http://127.0.0.1:8000

# SQLite database URL used by the app. The test suite overrides this per-run with
# a throwaway temp database so tests never touch your dev data.
# DATABASE_URL=sqlite:///./todo.db

# --- Container / docker-compose config ---
# Host port to publish the app on (container always listens on 8000).
# PORT=8000
# Inside the container the default is DATABASE_URL=sqlite:////data/todo.db, where
# /data is the persistent `todo-data` volume. Override here only to point the app
# at a different SQLite file.
